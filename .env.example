NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/note_app?retryWrites=true&w=majority
JWT_SECRET=generate-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000
TRUST_PROXY_HOPS=0

# Only set these temporarily when running the one-time admin setup:
# ADMIN_NAME=Project Admin
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=use-a-unique-password-of-at-least-12-characters
